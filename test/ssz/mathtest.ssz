// Math regression test — native PRNG core + trig/round
// (ssz_script/lib/math.cpp).  srand() seeds the native LCG, so the rand
// sequence is deterministic within a run.
lib f = <file.ssz>;
lib s = <string.ssz>;
lib m = <math.ssz>;

^/char r = "";
// deterministic PRNG sequence after srand
.m.srand(12345);
r = r + .s.uToSx((ulong).m.rand(0, 1000));
r = r + "|";
r = r + .s.uToSx((ulong).m.rand(0, 1000));
r = r + "|";
.m.srand(12345);                       // re-seed -> same first value
r = r + .s.uToSx((ulong).m.rand(0, 1000));
r = r + "|";
// trig / rounding spot values
r = r + .s.uToSx((ulong).m.sqrt(16.0));   // 4
r = r + "|";
r = r + .s.uToSx((ulong).m.floor(2.7));   // 2
r = r + "|";
r = r + .s.uToSx((ulong).m.ceil(2.1));    // 3
r = r + "|";
r = r + .s.uToSx((ulong)(.m.isnan(.m.sqrt(-1.0))));   // 1
r = r + "|";
r = r + .s.uToSx((ulong)(.m.isinf(1.0 / 0.0)));       // 1
.f.saveAsciiText("mathtest_out.txt", r);
