// ============================================================================
// video.ssz — thin wrapper for native video library.
// Transpiled from original ssz_script/ssz/video.ssz.
//
// Types and module-level variables stay here; method bodies delegate
// to ssz_script/ssz/video.cpp through the native lib registry.
// ============================================================================

lib cfg = "../save/config.ssz";

//Load "lib/" Scripts
lib al = <alert.ssz>;
lib consts = <consts.ssz>;
lib file = <file.ssz>;
lib m = <math.ssz>;
lib s = <string.ssz>;
lib tbl = <table.ssz>;

//Load "lib/alpha/" Scripts
lib sdl = <alpha/sdlplugin.ssz>;

//Load "script/ssz/" Scripts
lib com = "common.ssz";

// Native video library
lib vid_native = <video_native>;

public void error<_t>(^/char m)
{
	.al.alert!_t?(m);
}

public bool videoActive = false;

public &Video
{
	/^/char fileName;
	public void clear()
	{
		.vid_native.Video_clear();
	}
	public void play(^/char file, ^/char capturepath, int volume, int audiotrack)
	{
		.vid_native.Video_play(`fileName=, file, capturepath, volume, audiotrack);
	}
}
public ^&Video video.new(1);
