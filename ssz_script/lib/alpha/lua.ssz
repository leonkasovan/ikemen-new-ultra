lib ssz = <ssz.ssz>;

void refSetNull(ref o=)
{
  ref r;
  o = r;
}

void refCopy(ref o=, ref r)
{
  o = r;
}

void init()
{
  plugin void Init(:
    func .refSetNull.signature, func .refCopy.signature:) = <lua>;
  Init(:.refSetNull, .refCopy:);
}
init();

public bool runSsz(^/char file)
{
  bool re = .ssz.run(file);
  .init();
  ret re;
}

public &SszCompiler
{
  core &.ssz.Compiler c;
  public bool run()
  {
    bool re = `c.run();
    .init();
    ret re;
  }
}

// Native `lua` library (ssz_script/lib/alpha/lua.cpp) — re-exports the
// static <lua> plugin's fnptrs (the main/ssz/bridge.cpp wrappers), so the
// &State methods below can delegate here instead of declaring their own
// in-body `plugin` calls.  `init()`/`refSetNull`/`refCopy` stay in SSZ (they
// pass `func X.signature` values — signature references, not delegates) and
// `register` keeps its in-body plugin declaration because its func param
// captures the enclosing class (func$void(`self=, int=)) — a per-
// instantiation class id that a native signature cannot name.
lib lua = <lua>;

public &State
{
  index ptr = 0;
  new()
  {
    `ptr = .lua.newState();
  }
  delete()
  {
    if (`ptr != 0) {
      index tmp = `ptr;
      `ptr = 0;
      .lua.close(tmp);
    }
  }
  public bool runFile(^/char str)
  {
    ret .lua.runFile(`ptr, str);
  }
  public bool runString(^/char str)
  {
    ret .lua.runString(`ptr, str);
  }
  public int getTop()
  {
    ret .lua.getTop(`ptr);
  }
  public void getGlobal(^/char var)
  {
    .lua.getGlobal(`ptr, var);
  }
  public void register(^/char n, func$void(`self=, int=) f)
  {
    plugin void Register(:
      index, ^/char,  func$void(`self=, int=):) = <lua>;
    Register(:`ptr, n, f:);
  }
  public bool pcall(int nargs, int nresults)
  {
    ret .lua.pcall(`ptr, nargs, nresults);
  }
  public void pop(int n)
  {
    .lua.pop(`ptr, n);
  }
  public void pushNumber(double n)
  {
    .lua.pushNumber(`ptr, n);
  }
  public bool isNumber(int idx)
  {
    ret .lua.isNumber(`ptr, idx);
  }
  public double toNumber(int idx)
  {
    ret .lua.toNumber(`ptr, idx);
  }
  public void pushBoolean(bool b)
  {
    .lua.pushBoolean(`ptr, b);
  }
  public bool isBoolean(int idx)
  {
    ret .lua.isBoolean(`ptr, idx);
  }
  public bool toBoolean(int idx)
  {
    ret .lua.toBoolean(`ptr, idx);
  }
  public void pushString(^/char s)
  {
    .lua.pushString(`ptr, s);
  }
  public bool isString(int idx)
  {
    ret .lua.isString(`ptr, idx);
  }
  public ^char toString(int idx)
  {
    ^char tmp;
    .lua.toString(`ptr, tmp=, idx);
    ret tmp;
  }
  public void pushRef(ref r)
  {
    ref tmp = r;
    .lua.pushRef(`ptr, tmp=);
  }
  public ref toRef(int idx)
  {
    ref tmp;
    .lua.toRef(`ptr, tmp=, idx);
    ret tmp;
  }
}
