|CodePage
{
  ACP        = 0,           // default to ANSI code page
  OEMCP      = 1,           // default to OEM  code page
  MACCP      = 2,           // default to MAC  code page
  THREAD_ACP = 3,           // current thread's ANSI code page
  SYMBOL     = 42,          // SYMBOL translations

  SJIS       = 932,

  ISO_8859_1 = 1252,

  EUC_JP     = 20932,

  UTF7       = 65000,       // UTF-7 translation
  UTF8       = 65001        // UTF-8 translation
}

// Native `mesdialog` library (ssz_script/lib/alpha/mesdialog.cpp) — re-exports
// the static <mesdialog> plugin's fnptrs (the main/ssz/bridge.cpp wrappers),
// so the module functions below can delegate here instead of declaring their
// own `plugin` calls.  `|CodePage` must be declared before this import (its
// enum type is referenced by the ubytesToStr/strToUbytes signatures).
lib md = <mesdialog>;

public bool YesNo(^/char r)
{
  ret .md.yesNo(r);
}

public bool GetClipboardStr(^char s=)
{
  ret .md.getClipboardStr(s=);
}

public void GetInifileString(^/char def, ^/char key, ^/char app, ^/char file, ^char s=)
{
  .md.getInifileString(def, key, app, file, s=);
}

public int GetInifileInt(^/char def, ^/char key, ^/char app, int n)
{
  ret .md.getInifileInt(def, key, app, n);
}

public bool WriteInifileString(^/char s, ^/char key, ^/char app, ^/char file)
{
  ret .md.writeInifileString(s, key, app, file);
}

public void InputStr(^/char title, ^char s=)
{
  .md.inputStr(title, s=);
}

public bool UnCompress(^ubyte out=, ^/ubyte src)
{
  ret .md.unCompress(out=, src);
}

public void UbytesToStr(|.CodePage cp, ^char s=, ^/ubyte b)
{
  .md.ubytesToStr(cp, s=, b);
}

public void StrToUbytes(|.CodePage cp, ^ubyte out=, ^/char s)
{
  .md.strToUbytes(cp, out=, s);
}

public void AsciiToLocal(^char s=, ^/char src)
{
  .md.asciiToLocal(s=, src);
}

public void SetSharedString(^/char s)
{
  .md.setSharedString(s);
}

public void GetSharedString(^char s=)
{
  .md.getSharedString(s=);
}

// Template-bound by definition (`dst_t`/`src_t` are re-parsed per
// instantiation); keeps its in-body plugin declaration, resolved from the
// static plugin registry (which coexists with the native registry).
public void veryUnsafeCopy<dst_t, src_t>(dst_t d=, src_t s=)
{
  lib math = <math.ssz>;
  plugin void VeryUnsafeCopy(:dst_t=, src_t=, index:) = <mesdialog>;
  VeryUnsafeCopy(:d=, s=, math.min!index?(typesize(dst_t), typesize(src_t)):);
}

index thandle = 0;

public bool tajuuCheck(^/char name)
{
  if(.thandle == 0) .thandle = .md.tazyuuCheck(name);
  ret .thandle == 0;
}

&Releaser
{
  delete()
  {
    if(.thandle != 0) .md.closeTazyuuHandle(.thandle);
  }
}
&Releaser rls;
