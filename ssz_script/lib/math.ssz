lib consts = <consts.ssz>;
// Native PRNG core (random/srand/rand/randI/randF + randseed state) —
// implemented in C++ at ssz_script/lib/math.cpp.  The template functions
// (min/max/...) and trig plugin wrappers below stay in SSZ.
lib mn = <math>;

const double PI = 3.141592653589793238462643383279502884197;
const double E  = 2.718281828459045235360287471352662497757;

public double sin(double x)
{
  plugin double Sin(:double:) = <math>;
  ret Sin(:x:);
}

public double cos(double x)
{
  plugin double Cos(:double:) = <math>;
  ret Cos(:x:);
}

public double tan(double x)
{
  plugin double Tan(:double:) = <math>;
  ret Tan(:x:);
}

public double asin(double x)
{
  plugin double ASin(:double:) = <math>;
  ret ASin(:x:);
}

public double acos(double x)
{
  plugin double ACos(:double:) = <math>;
  ret ACos(:x:);
}

public double atan(double x)
{
  plugin double ATan(:double:) = <math>;
  ret ATan(:x:);
}

public double log(double x, double y)
{
  plugin double Log(:double, double:) = <math>;
  ret Log(:x, y:);
}

public double ln(double x)
{
  plugin double Ln(:double:) = <math>;
  ret Ln(:x:);
}

public double exp(double x)
{
  plugin double Exp(:double:) = <math>;
  ret Exp(:x:);
}

public double sqrt(double x)
{
  plugin double Sqrt(:double:) = <math>;
  ret Sqrt(:x:);
}

public double ceil(double x)
{
  plugin double Ceil(:double:) = <math>;
  ret Ceil(:x:);
}

public double floor(double x)
{
  plugin double Floor(:double:) = <math>;
  ret Floor(:x:);
}

public double round(double x)
{
  double fx = x, cx = x;
  ret x < 0.0 ? -.floor(0.5 - x) : .floor(0.5 + x);
}

public bool isfinite(double x)
{
  plugin bool IsFinite(:double:) = <math>;
  ret IsFinite(:x:);
}

public bool isinf(double x)
{
  plugin bool IsInf(:double:) = <math>;
  ret IsInf(:x:);
}

public bool isnan(double x)
{
  plugin bool IsNaN(:double:) = <math>;
  ret IsNaN(:x:);
}

const int RANDMAX = .consts.int_t::MAX;

public int random()
{
  ret .mn.random();
}

public void srand(int s)
{
  .mn.srand(s);
}

public int rand(int min, int max)
{
  ret .mn.rand(min, max);
}

public int randI(int x, int y)
{
  ret .mn.randI(x, y);
}

public float randF(float x, float y)
{
  ret .mn.randF(x, y);
}

public ..min<_t>(_t x, _t y) _t
{
  ret x < y ? x : y;
}

public ..max<_t>(_t x, _t y) _t
{
  ret x > y ? x : y;
}

public bool inRange<_t>(_t start, _t end, _t x)
{
  ret start <= x && x <= end;
}

public void limMax<_t>(_t x=, _t y)
{
  x = .min!_t?(x, y);
}

public void limMin<_t>(_t x=, _t y)
{
  x = .max!_t?(x, y);
}

public void limRange<_t>(_t x=, _t low, _t high)
{
  x = .max!_t?(.min!_t?(x, high), low);
}

public void swap<_t>(_t x=, _t y=)
{
  *_t tmp = x;
  x = y;
  y = tmp;
}