public void memMarkBefore(^/char label)
{
  plugin void MemMarkBefore(:^/char:) = <dll/ssz.dll>;
  MemMarkBefore(:label:);
}

public void memMarkAfter(^/char label)
{
  plugin void MemMarkAfter(:^/char:)  = <dll/ssz.dll>;
  MemMarkAfter(:label:);
}

public void procMemMark(^/char label)
{
  plugin void ProcMemMark(:^/char:) = <dll/ssz.dll>;
  ProcMemMark(:label:);
}

public void setProfilerLog(bool enable)
{
  plugin void SetProfilerLog(:bool:) = <dll/ssz.dll>;
  SetProfilerLog(:enable:);
}

public void profBegin(^/char label)
{
  plugin void ProfBegin(:^/char:) = <dll/ssz.dll>;
  ProfBegin(:label:);
}

public void profEnd(^/char label)
{
  plugin void ProfEnd(:^/char:)  = <dll/ssz.dll>;
  ProfEnd(:label:);
}

public bool run(^/char file)
{
  plugin bool Run(:^/char:) = <dll/ssz.dll>;
  ret Run(:file:);
}

public &Compiler
{
  index ptr;
  new()
  {
    plugin index NewCompiler(::) = <dll/ssz.dll>;
    `ptr = NewCompiler(::);
  }
  delete()
  {
    plugin void DeleteCompiler(:index:) = <dll/ssz.dll>;
    DeleteCompiler(:`ptr:);
  }
  public ^/char compile(^/char file)
  {
    plugin void CompilerCompile(:index, ^/char, ^/char=:) = <dll/ssz.dll>;
    ^/char error;
    CompilerCompile(:`ptr, file, error=:);
    ret error;
  }
  public ^/char compileString(^/char code, ^/char dir)
  {
    plugin void CompilerCompileString(:
      index, ^/char, ^/char, ^/char=:) = <dll/ssz.dll>;
    ^/char error;
    CompilerCompileString(:`ptr, code, dir, error=:);
    ret error;
  }
  public bool run()
  {
    plugin bool CompilerRun(:index:) = <dll/ssz.dll>;
    ret CompilerRun(:`ptr:);
  }
}