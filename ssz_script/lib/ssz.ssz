// ssz.ssz — the `ssz` library.
//
// The module functions (memMarkBefore/memMarkAfter/run) and the `&Compiler`
// struct methods are implemented in C++ at ssz_script/lib/ssz.cpp and
// delegated below; the struct keeps only its `index ptr` field.  The static
// `ssz` plugin and this native lib coexist.

lib sz = <ssz>;

public void memMarkBefore(^/char label)
{
  .sz.memMarkBefore(label);
}

public void memMarkAfter(^/char label)
{
  .sz.memMarkAfter(label);
}

public bool run(^/char file)
{
  ret .sz.run(file);
}

public &Compiler
{
  index ptr;
  new()
  {
    `ptr = .sz.newCompiler();
  }
  delete()
  {
    .sz.deleteCompiler(`ptr=);
  }
  public ^/char compile(^/char file)
  {
    ^/char error;
    .sz.compilerCompile(`ptr, file, error=);
    ret error;
  }
  public ^/char compileString(^/char code, ^/char dir)
  {
    ^/char error;
    .sz.compilerCompileString(`ptr, code, dir, error=);
    ret error;
  }
  public bool run()
  {
    ret .sz.compilerRun(`ptr);
  }
}
