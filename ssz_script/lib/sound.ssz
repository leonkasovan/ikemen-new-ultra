// sound.ssz — the `sound` library.
//
// The `&Client` struct methods (new/delete/start/stop/bufferReady/setBuffer)
// are implemented in C++ at ssz_script/lib/sound.cpp and delegated below;
// the struct keeps only its `index cl` field.  The static `sound` plugin and
// this native lib coexist.

const int Freq = 48000;
const int Channels = 2;
const int BufferSamples = 2048;

lib sn = <sound>;

public &Client
{
  index cl = 0;
  new()
  {
    `cl = .sn.newClient();
  }
  delete()
  {
    .sn.deleteClient(`cl=);
  }
  public bool start()
  {
    ret .sn.clientStart(`cl);
  }
  public bool stop()
  {
    ret .sn.clientStop(`cl);
  }
  public bool bufferReady()
  {
    ret .sn.clientBufferReady(`cl);
  }
  public bool setBuffer(^/float buffer)
  {
    ret .sn.clientSetBuffer(`cl, buffer);
  }
}
