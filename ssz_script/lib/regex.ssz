// regex.ssz — the `regex` library.
//
// The `&Regex` struct methods (clear/init/search) are implemented in C++ at
// ssz_script/lib/regex.cpp and delegated below; the struct keeps only its
// `index re` field.  The native lib re-exports the static bridge wrappers,
// so the static `regex` plugin and this native lib coexist.

lib rx = <regex>;

public &Regex
{
  index re = 0;
  const int I = 1;
  delete()
  {
    `clear();
  }
  void clear()
  {
    .rx.deleteRegex(`re=);
  }
  public ^char init(^/char reText, int flag)
  {
    `clear();
    ^char error;
    `re = .rx.newRegex(reText, (flag&`I) != 0, error=);
    ret error;
  }
  public ^^/char search(^/char str)
  {
    ^^/char matches;
    .rx.regexSearch(`re, str, matches=);
    ret matches;
  }
}
