// The &Md5 struct's streaming methods (init/process/append/finish) are
// implemented in C++ at ssz_script/lib/md5.cpp and delegated below.
lib md = <md5>;

public &Md5
{
  /^uint count; /* message length in bits, lsw first */
  /^uint abcd;  /* digest buffer */
  /^ubyte buf;  /* accumulate block */
  new()
  {
    `count.new(2);
    `abcd.new(4);
    `buf.new(64);
    `init();
  }
  public void init()
  {
    .md.md5Init(`count=, `abcd=);
  }
  void process(^/ubyte data /*[64]*/)
  {
    .md.md5Process(`abcd=, data);
  }
  public void append(^/ubyte data)
  {
    .md.md5Append(`count=, `abcd=, `buf=, data);
  }
  public ^ubyte finish()
  {
    ret .md.md5Finish(`count=, `abcd=, `buf=);
  }
}

// One-shot hash functions — implemented in C++ at ssz_script/lib/md5.cpp
// (RFC 1321, matching this file's &Md5 streaming implementation).
public ^ubyte md5(^/ubyte data)
{
  ret .md.md5(data);
}

public ^char md5str(^/ubyte data)
{
  ret .md.md5str(data);
}