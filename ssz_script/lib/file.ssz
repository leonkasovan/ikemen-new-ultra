// file.ssz — the `file` library.
//
// The plain module functions (loadAsciiText/saveAsciiText/remove/move/copy/
// find/findDir/createDir/removeDir/setCurrentDir/getCurrentDir) are
// implemented in C++ at ssz_script/lib/file.cpp and delegated below.  The
// stateful `&File` struct, its `|Seek` enum, and the `readAll<_t>` template
// stay in SSZ — their `plugin ... = <file>` declarations still resolve to the
// static `file` plugin (main/file/file.cpp via the static plugin registry).

lib fl = <file>;

|Seek
{
  SET = 0, CUR = 1, END = 2
}

public &File
{
  index fh = 0;
  delete()
  {
    `close();
  }
  public bool isOpened()
  {
    ret .fl.fileIsOpened(`fh);
  }
  public bool open(^/char fn, ^/char mode)
  {
    ret .fl.fileOpen(`fh=, fn, mode);
  }
  public void close()
  {
    .fl.fileClose(`fh=);
  }
  public bool read<_t>(_t x=)
  {
  /?/*typeid(_t) < 0:
    ret false;
  /*true:
    x = x;//Do not read anything from a file that cannot be copied by assignment.
    plugin bool Read(:index, _t=, index:) = <file>;
    ret Read(:`fh, x=, typesize(_t):);
  /*?*/
  }
  public index readAry<_t>(^_t x)
  {
  /?/*typeid(_t) < 0:
    ret -1;
  /*true:
    if(#x == 0) ret 0;
    x<> = x<>;//Do not read anything from a file that cannot be copied by assignment.
    plugin index ReadAry(:index, ^_t, index:) = <file>;
    ret ReadAry(:`fh, x, typesize(_t):);
  /*?*/
  }
  public bool write<_t>(_t x=)
  {
    plugin bool Write(:index, _t=, index:) = <file>;
    ret Write(:`fh, x=, typesize(_t):);
  }
  public index writeAry<_t>(^/_t x)
  {
    plugin index WriteAry(:index, ^/_t, index:) = <file>;
    ret WriteAry(:`fh, x, typesize(_t):);
  }
  public bool seek(long offset, |.Seek origin)
  {
    ret .fl.fileSeek(`fh, offset, (int)origin);
  }
}

public ..readAll<_t>(^/char fln) ^_t
{
  %_t buf;
  loop{
    &.File f.open(fln, "rb");
    *_t x;
    while;
  do:
    buf .= x;
  while f.read!_t?(x=):
  }
  ret buf;
}

public ^char loadAsciiText(^/char fn)
{
  ret .fl.loadAsciiText(fn);
}

public bool saveAsciiText(^/char fn, ^/char txt)
{
  ret .fl.saveAsciiText(fn, txt);
}

public bool remove(^/char fn)
{
  ret .fl.remove(fn);
}

public bool move(^/char oldn, ^/char newn)
{
  ret .fl.move(oldn, newn);
}

public bool copy(^/char source, ^/char dist, bool overwrite)
{
  ret .fl.copy(source, dist, overwrite);
}

public ^^char find(^/char fn)
{
  %^char ls;
  .fl.find(fn, ls=);
  ret ls;
}

public ^^char findDir(^/char fn)
{
  %^char ls;
  .fl.findDir(fn, ls=);
  ret ls;
}

public bool createDir(^/char dir)
{
  ret .fl.createDir(dir);
}

public bool removeDir(^/char dir)
{
  ret .fl.removeDir(dir);
}

public bool setCurrentDir(^/char cdir)
{
  ret .fl.setCurrentDir(cdir);
}

public ^/char getCurrentDir()
{
  ret .fl.getCurrentDir();
}
