// One-shot RC4 encrypt + the &Arcfour struct methods — implemented in C++
// at ssz_script/lib/arcfour.cpp (matches this file's streaming semantics).
lib arc = <arcfour>;

public &Arcfour
{
  uint x, y;
  ^ubyte state;
  new()
  {
    `state.new(256);
  }
  public void init(^/ubyte key)
  {
    .arc.init(`x=, `y=, `state=, key);
  }
  public ubyte getByte()
  {
    ret .arc.getByte(`x=, `y=, `state=);
  }
  public ^ubyte encrypt(^/ubyte src)
  {
    ret .arc.encrypt(`x=, `y=, `state=, src);
  }
}

public bool arcfourEnc(^ubyte dest=, ^/ubyte key, ^/ubyte src)
{
  ret .arc.arcfourEnc(dest=, key, src);
}