// Native core — the char-conversion helpers (uintToB64Char/b64CharToUint)
// and the byte-level base64 core (encB64/decB64) are implemented in C++ at
// ssz_script/lib/base64.cpp.  The generic templates (encBase64<_t>/
// decBase64<_t>) delegate to the byte-level core when the element type is
// byte-sized (typesize(_t) == 1) and fall back to the original SSZ
// bit-packing for wider element types, whose per-element big-endian bit
// layout differs from the raw memory bytes.
lib b64 = <base64>;

public char uintToB64Char(uint n)
{
  ret .b64.uintToB64Char(n);
}

public uint b64CharToUint(char c)
{
  ret .b64.b64CharToUint(c);
}

public ^char encBase64<_t>(^/_t data)
{
  %ubyte ub;
  branch{
  cond typesize(_t) == 1:
    loop{index i = 0; while; do:
      ub .= (ubyte)data[i];
      i++;
    while i < #data:}
    ret .b64.encB64(ub);
  }
  %char buf;
  loop{
    index i = 0, bii = 0;
    while;
  do:
    bii += 6;
    branch{
    cond bii > typesize(_t)*8:
      bii -= typesize(_t)*8;
      i++;
      buf .=
        .uintToB64Char(
          (
            (
              (uint)(
                (i < #data ? data[i] : (*_t)0) >> (*_t)(typesize(_t)*8 - bii))
              & (uint)((1<<bii) - 1))
            | (uint)(data[i-1] << (*_t)bii)) & 0x3f);
    else:
      buf .=
        .uintToB64Char((uint)(data[i] >> (*_t)(typesize(_t)*8 - bii)) & 0x3f);
    }
  while i < #data:
    loop{while; do:
      buf .= '=';
      bii += 6;
    while (bii & 6) != 0:}
  }
  ret buf;
}

public ..decBase64<_t>(^/char b64) ^_t
{
  ^ubyte ub;
  %_t buf;
  branch{
  cond typesize(_t) == 1:
    ub = .b64.decB64(b64);
    loop{index i = 0; while; do:
      buf .= (_t)ub[i];
      i++;
    while i < #ub:}
    ret buf;
  }
  loop{
    index i = 0, bii = 0;
    *_t x = (*_t)0;
    uint tmp;
    while;
  do:
    tmp = .b64CharToUint(b64[i++]);
    if(tmp > 0d63) while;
    bii += 6;
    if(bii > typesize(_t)*8){
      bii -= typesize(_t)*8;
      x |= (*_t)tmp >> (*_t)bii;
      buf .= x;
      x = (*_t)0;
    }
    x |= (*_t)tmp << (*_t)(typesize(_t)*8 - bii);
  while i < #b64:
  }
  ret buf;
}
